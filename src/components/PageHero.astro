---
interface Props {
  title: string;
  subtitle?: string;
  crumbs?: { href: string; label: string }[];
}
const { title, subtitle, crumbs = [] } = Astro.props;
---

<section class="bg-gradient-to-r from-brand-900 to-brand-600 text-white">
  <div class="container-x py-10 sm:py-14">
    {
      crumbs.length > 0 && (
        <nav class="mb-3 text-xs text-white/70">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span class="mx-1">/</span>}
              <a href={c.href} class="hover:text-white">
                {c.label}
              </a>
            </>
          ))}
        </nav>
      )
    }
    <h1 class="text-2xl font-bold sm:text-4xl">{title}</h1>
    {subtitle && <p class="mt-3 max-w-3xl text-white/80">{subtitle}</p>}
  </div>
</section>
