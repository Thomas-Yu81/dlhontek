---
import { localePath, switchLangPath, useT, type Lang } from '../i18n';
import { categories } from '../data/categories';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const path = Astro.url.pathname;
const nav = [
  { href: localePath(lang, '/'), label: t('nav.home') },
  { href: localePath(lang, '/products/'), label: t('nav.products'), sub: true },
  { href: localePath(lang, '/solutions/'), label: t('nav.solutions') },
  { href: localePath(lang, '/about/'), label: t('nav.about') },
  { href: localePath(lang, '/contact/'), label: t('nav.contact') },
];
const isActive = (href: string) =>
  href === localePath(lang, '/') ? path === href : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href={localePath(lang, '/')} class="flex items-center gap-2">
      <img src="/favicon.svg" alt="" class="h-8 w-8" />
      <span class="text-lg font-bold tracking-wide text-brand-900">{site.brand}</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex">
      {
        nav.map((n) => (
          <div class="group relative">
            <a
              href={n.href}
              class:list={[
                'rounded px-3 py-2 text-sm font-medium hover:text-brand-600',
                isActive(n.href) ? 'text-brand-600' : 'text-slate-700',
              ]}
            >
              {n.label}
            </a>
            {n.sub && (
              <div class="invisible absolute left-0 top-full w-64 rounded-md border border-slate-200 bg-white py-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
                {categories.map((c) => (
                  <a
                    href={localePath(lang, `/products/${c.id}/`)}
                    class="block px-4 py-2 text-sm hover:bg-brand-50 hover:text-brand-600"
                  >
                    {c.name[lang]}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={localePath(lang, '/search/')}
        class="rounded p-2 text-slate-600 hover:text-brand-600"
        aria-label={t('nav.search')}
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
        >
      </a>
      <a
        href={switchLangPath(path, lang === 'zh' ? 'en' : 'zh')}
        class="rounded border border-slate-300 px-2 py-1 text-xs font-medium hover:border-brand-600 hover:text-brand-600"
      >
        {t('lang.switch')}
      </a>
      <a href={localePath(lang, '/contact/')} class="btn btn-primary hidden sm:inline-flex">
        {t('btn.inquiry')}
      </a>
      <details class="md:hidden">
        <summary class="list-none rounded p-2" aria-label="menu">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
            ><path d="M4 6h16M4 12h16M4 18h16"></path></svg
          >
        </summary>
        <div class="absolute inset-x-0 top-16 border-b border-slate-200 bg-white shadow">
          {
            nav.map((n) => (
              <a href={n.href} class="block border-t border-slate-100 px-6 py-3 text-sm">
                {n.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</header>
