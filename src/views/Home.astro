---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories } from '../data/categories';
import { getProducts, productsIn } from '../data/products';
import { site } from '../data/site';
import { localePath, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const all = await getProducts();
const featured = all.filter((p) => p.data.featured);
const why =
  lang === 'zh'
    ? [
        ['源头制造', '自有生产线与检测中心，交期可控、质量可追溯。'],
        ['选型支持', '工程师一对一选型，提供工况核算与方案图纸。'],
        ['行业经验', '服务市政水务、污水处理、化工、电力等上千个项目。'],
        ['完善售后', '全国服务网络，7×24 小时技术响应。'],
      ]
    : [
        ['Direct Manufacturer', 'In-house production & testing for reliable lead times and traceable quality.'],
        ['Sizing Support', 'One-to-one engineering support with process calculations and drawings.'],
        ['Industry Experience', 'Thousands of projects in water utilities, wastewater, chemical and power.'],
        ['After-sales Service', 'Nationwide service network with 24/7 technical response.'],
      ];
---

<Base lang={lang} title={site.slogan[lang]}>
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-700 to-brand-500 text-white">
    <div class="container-x grid items-center gap-10 py-16 md:grid-cols-2 md:py-24">
      <div>
        <p class="text-sm font-medium uppercase tracking-widest text-white/70">{site.brand}</p>
        <h1 class="mt-3 text-3xl font-bold leading-tight sm:text-5xl">{site.slogan[lang]}</h1>
        <p class="mt-5 max-w-xl text-white/80">
          {categories.map((c) => c.name[lang]).join(lang === 'zh' ? ' · ' : ' · ')}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={localePath(lang, '/products/')} class="btn bg-white text-brand-700 hover:bg-brand-50">
            {t('btn.all')}
          </a>
          <a href={localePath(lang, '/contact/')} class="btn border border-white/60 text-white hover:bg-white/10">
            {t('btn.inquiry')}
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {
          categories.map((c) => (
            <a
              href={localePath(lang, `/products/${c.id}/`)}
              class="rounded-lg bg-white/10 p-4 backdrop-blur transition hover:bg-white/20"
            >
              <img src={c.placeholder} alt="" class="mx-auto h-20 w-20" />
              <div class="mt-2 text-center text-sm font-medium">{c.name[lang]}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-x py-16">
    <h2 class="section-title">{t('home.categories')}</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((c) => (
          <a
            href={localePath(lang, `/products/${c.id}/`)}
            class="rounded-lg border border-slate-200 p-6 transition hover:border-brand-500 hover:shadow-md"
          >
            <img src={c.placeholder} alt="" class="h-14 w-14" />
            <h3 class="mt-4 font-semibold text-slate-900">{c.name[lang]}</h3>
            <p class="mt-2 text-sm text-slate-500">{c.desc[lang]}</p>
            <p class="mt-3 text-xs text-brand-600">
              {t('products.count', { n: productsIn(all, c.id).length })}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="bg-slate-50 py-16">
    <div class="container-x">
      <div class="flex items-end justify-between">
        <h2 class="section-title">{t('home.featured')}</h2>
        <a href={localePath(lang, '/products/')} class="text-sm font-medium text-brand-600">{t('btn.all')} →</a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p) => <ProductCard lang={lang} product={p} />)}
      </div>
    </div>
  </section>

  <section class="container-x py-16">
    <h2 class="section-title">{t('home.why')}</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        why.map(([title, desc], i) => (
          <div class="rounded-lg border border-slate-200 p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-50 font-bold text-brand-600">
              {i + 1}
            </div>
            <h3 class="mt-4 font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-500">{desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-brand-600 text-white">
    <div class="container-x flex flex-col items-center gap-4 py-12 text-center">
      <h2 class="text-2xl font-bold">{t('home.cta')}</h2>
      <p class="text-white/80">{t('home.ctaDesc')}</p>
      <a href={localePath(lang, '/contact/')} class="btn bg-white text-brand-700 hover:bg-brand-50">
        {t('btn.inquiry')}
      </a>
    </div>
  </section>
</Base>
