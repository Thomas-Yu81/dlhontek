---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { localePath, useT, type Lang } from '../i18n';
import { getCategory, type CategoryId } from '../data/categories';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const items: { title: string; desc: string; cats: CategoryId[] }[] =
  lang === 'zh'
    ? [
        { title: '给水与污水处理', desc: '曝气池溶解氧、pH/ORP、余氯在线监测，回流污泥、二沉池、浓缩池的污泥浓度与泥水界面测量。', cats: ['water-quality', 'concentration'] },
        { title: '选矿、洗煤与造纸', desc: '矿浆、煤浆、灰浆、纸浆浓度在线监测，配合管道流量计量实现工艺自动控制。', cats: ['concentration', 'flow'] },
        { title: '石油、化工与电力', desc: '电磁、涡街、涡轮及超声波流量计，适用于导电液体、蒸汽、气体和腐蚀性介质的流量测量。', cats: ['flow', 'water-quality'] },
        { title: '水利、供热与环境工程', desc: '明渠流量、河道/水库水位、罐池液位与液位差测量，以及供热管网的超声波热量计量。', cats: ['level', 'flow'] },
      ]
    : [
        { title: 'Water & Wastewater', desc: 'Online DO, pH/ORP and residual chlorine monitoring; sludge concentration and sludge blanket measurement in return sludge, clarifiers and thickeners.', cats: ['water-quality', 'concentration'] },
        { title: 'Mining, Coal Washing & Paper', desc: 'Online slurry, coal slurry, mortar and pulp concentration monitoring with pipe flow metering for automatic process control.', cats: ['concentration', 'flow'] },
        { title: 'Oil, Chemical & Power', desc: 'Electromagnetic, vortex, turbine and ultrasonic flowmeters for conductive liquids, steam, gas and corrosive media.', cats: ['flow', 'water-quality'] },
        { title: 'Hydrology, Heating & Environment', desc: 'Open channel flow, river and reservoir water level, tank level and level difference, and ultrasonic heat metering for heating networks.', cats: ['level', 'flow'] },
      ];
---

<Base lang={lang} title={t('nav.solutions')}>
  <PageHero title={t('nav.solutions')} crumbs={[{ href: localePath(lang, '/'), label: t('nav.home') }]} />
  <section class="container-x grid gap-6 py-12 md:grid-cols-2">
    {
      items.map((s) => (
        <div class="rounded-lg border border-slate-200 p-6">
          <h2 class="text-lg font-semibold text-slate-900">{s.title}</h2>
          <p class="mt-2 text-sm text-slate-600">{s.desc}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {s.cats.map((c) => (
              <a href={localePath(lang, `/products/${c}/`)} class="rounded-full bg-brand-50 px-3 py-1 text-sm text-brand-700 hover:bg-brand-100">
                {getCategory(c).name[lang]}
              </a>
            ))}
            <a href={localePath(lang, '/contact/')} class="px-1 py-1 text-sm font-medium text-brand-600 hover:underline">{t('btn.inquiry')} →</a>
          </div>
        </div>
      ))
    }
  </section>
</Base>
