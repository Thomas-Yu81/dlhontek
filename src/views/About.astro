---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { localePath, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const stats =
  lang === 'zh'
    ? [['2010', '创立（大连宏泰仪表厂）'], ['4', '产品系列'], ['10+', '高级职称技术人员'], ['定制', '按需订制产品']]
    : [['2010', 'Founded (Dalian Hongtai Instrument Factory)'], ['4', 'Product lines'], ['10+', 'Senior engineers'], ['Custom', 'Built to order']];
---

<Base lang={lang} title={t('nav.about')}>
  <PageHero title={t('nav.about')} crumbs={[{ href: localePath(lang, '/'), label: t('nav.home') }]} />
  <section class="container-x grid gap-10 py-12 lg:grid-cols-3">
    <div class="space-y-4 text-slate-600 lg:col-span-2">
      <h2 class="section-title">{site.company[lang]}</h2>
      {
        lang === 'zh' ? (
          <>
            <p>{site.company.zh}座落于全国自动化仪表生产基地、素有北方明珠之称的海滨城市大连，是集产品研发、生产、销售为一体的现代化企业，专业从事工业自动化仪表的生产和制造。</p>
            <p>公司主要产品包括：浓度仪表（浊度计、悬浮物浓度计、超声波浓度计）；流量仪表（超声波流量计、超声波明渠流量计、电磁流量计、涡轮流量计）；液（物）位仪表（超声波液位计、超声波液位差计）；以及配套水质分析仪表（PH/ORP 监控仪、溶氧仪、超声波泥水界面仪）。</p>
            <p>公司拥有高级职称技术人员十余名，长期与高校合作，能按客户要求提供订制产品。产品广泛应用于国防、石油、化工、冶金、电力、制药、食品、供热、环境工程等众多行业。</p>
          </>
        ) : (
          <>
            <p>{site.company.en} is located in Dalian, a coastal city known as the Pearl of the North and a national base for automation instruments. We integrate R&D, manufacturing and sales, specializing in industrial automation instruments.</p>
            <p>Our products include concentration meters (turbidity, suspended solids and ultrasonic concentration meters), flowmeters (ultrasonic, ultrasonic open channel, electromagnetic and turbine), level meters (ultrasonic level and level difference meters), and water quality analyzers (pH/ORP, dissolved oxygen and ultrasonic sludge blanket meters).</p>
            <p>With more than ten senior engineers and long-term university partnerships, we can build products to customer requirements. Our instruments serve defense, petroleum, chemical, metallurgy, power, pharmaceutical, food, district heating and environmental engineering industries.</p>
          </>
        )
      }
    </div>
    <div class="grid grid-cols-2 gap-4">
      {
        stats.map(([n, l]) => (
          <div class="rounded-lg bg-brand-50 p-5 text-center">
            <div class="text-3xl font-bold text-brand-600">{n}</div>
            <div class="mt-1 text-sm text-slate-600">{l}</div>
          </div>
        ))
      }
    </div>
  </section>
</Base>
