---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getCategory } from '../data/categories';
import { getProducts, productImage, productsIn, type Product } from '../data/products';
import { localePath, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  product: Product;
}
const { lang, product: p } = Astro.props;
const t = useT(lang);
const d = p.data;
const cat = getCategory(d.category);
const images = d.images.length ? d.images : [productImage(p)];
const related = productsIn(await getProducts(), d.category)
  .filter((x) => x.id !== p.id)
  .slice(0, 4);
const body = d.body[lang];
const crumbs = [
  { href: localePath(lang, '/'), label: t('nav.home') },
  { href: localePath(lang, '/products/'), label: t('nav.products') },
  { href: localePath(lang, `/products/${d.category}/`), label: cat.name[lang] },
];
---

<Base lang={lang} title={`${d.name[lang]} ${d.model}`} description={d.summary[lang]}>
  <div class="border-b border-slate-200 bg-slate-50">
    <nav class="container-x py-3 text-xs text-slate-500">
      {
        crumbs.map((c) => (
          <>
            <a href={c.href} class="hover:text-brand-600">
              {c.label}
            </a>
            <span class="mx-1">/</span>
          </>
        ))
      }
      <span class="text-slate-700">{d.model}</span>
    </nav>
  </div>

  <article class="container-x py-10" data-pagefind-body>
    <div class="grid gap-10 lg:grid-cols-2">
      <div data-gallery>
        <div class="aspect-[4/3] overflow-hidden rounded-lg border border-slate-200 bg-slate-50">
          <img src={images[0]} alt={d.name[lang]} class="h-full w-full object-contain p-6" data-main data-pagefind-meta="image[src]" />
        </div>
        {
          images.length > 1 && (
            <div class="mt-3 flex gap-2">
              {images.map((src) => (
                <button type="button" data-thumb={src} class="h-16 w-16 overflow-hidden rounded border border-slate-200 hover:border-brand-500">
                  <img src={src} alt="" class="h-full w-full object-contain" />
                </button>
              ))}
            </div>
          )
        }
      </div>
      <div>
        <div class="text-sm font-medium text-brand-600">{t('product.model')}: {d.model}</div>
        <h1 class="mt-2 text-2xl font-bold text-slate-900 sm:text-3xl" data-pagefind-meta="title">{d.name[lang]}</h1>
        <p class="mt-4 text-slate-600">{d.summary[lang]}</p>
        {
          d.features[lang].length > 0 && (
            <>
              <h2 class="mt-6 font-semibold text-slate-900">{t('product.features')}</h2>
              <ul class="mt-2 space-y-1.5 text-sm">
                {d.features[lang].map((f) => (
                  <li class="flex gap-2">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" />
                    {f}
                  </li>
                ))}
              </ul>
            </>
          )
        }
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#inquiry" class="btn btn-primary">{t('btn.inquiry')}</a>
          {d.datasheet && <a href={d.datasheet} class="btn btn-outline" download>{t('btn.datasheet')}</a>}
        </div>
      </div>
    </div>

    <section class="mt-12">
      <h2 class="section-title text-xl">{t('product.specs')}</h2>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <tbody>
            {
              d.specs.map((s, i) => (
                <tr class={i % 2 ? 'bg-white' : 'bg-slate-50'}>
                  <th class="w-1/3 border border-slate-200 px-4 py-2.5 text-left font-medium text-slate-700">
                    {s.label[lang]}
                  </th>
                  <td class="border border-slate-200 px-4 py-2.5">
                    {typeof s.value === 'string' ? s.value : s.value[lang]}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {body && <section class="prose-product mt-12" set:html={body} />}

    {
      d.applications[lang].length > 0 && (
        <section class="mt-12">
          <h2 class="section-title text-xl">{t('product.applications')}</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {d.applications[lang].map((a) => (
              <span class="rounded-full bg-brand-50 px-3 py-1 text-sm text-brand-700">{a}</span>
            ))}
          </div>
        </section>
      )
    }
  </article>

  <section id="inquiry" class="bg-slate-50 py-12">
    <div class="container-x max-w-3xl">
      <h2 class="section-title text-xl">{t('form.title')}</h2>
      <div class="mt-6 rounded-lg bg-white p-6 shadow-sm">
        <InquiryForm lang={lang} product={`${d.model} ${d.name[lang]}`} />
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="container-x py-12">
        <h2 class="section-title text-xl">{t('product.related')}</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r) => <ProductCard lang={lang} product={r} />)}
        </div>
      </section>
    )
  }
</Base>

<script>
  for (const g of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const main = g.querySelector<HTMLImageElement>('[data-main]')!;
    g.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b) =>
      b.addEventListener('click', () => (main.src = b.dataset.thumb!)),
    );
  }
</script>
