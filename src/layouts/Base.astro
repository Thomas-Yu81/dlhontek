---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatContact from '../components/FloatContact.astro';
import { switchLangPath, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}
const { lang, title, description = site.slogan[lang] } = Astro.props;
const fullTitle = `${title} | ${site.brand}`;
const path = Astro.url.pathname;
const alt = new URL(switchLangPath(path, lang === 'zh' ? 'en' : 'zh'), Astro.site);
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {
      site.baiduTongji && (
        <script is:inline async src={`https://hm.baidu.com/hm.js?${site.baiduTongji}`} />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-700 antialiased">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <FloatContact lang={lang} />
    {site.chatScript && <script is:inline async src={site.chatScript} />}
  </body>
</html>
